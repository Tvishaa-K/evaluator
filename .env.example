# Copy to .env and fill in. Never commit the real .env.

# Local dev: postgresql+psycopg://user:pass@localhost:5432/evaluator
# Managed Postgres: paste the provider URL as-is — app/db.py normalizes the
# scheme to postgresql+psycopg:// automatically.
DATABASE_URL=

DEEPGRAM_API_KEY=
SARVAM_API_KEY=

# Optional
# SARVAM_CHAT_MODEL=sarvam-105b-conversations
#   Default. Do NOT set this to sarvam-105b: it reasons before every answer,
#   and the trace exhausts the completion budget before any JSON is emitted
#   (finish_reason=length, empty content). sarvam-30b and sarvam-m are
#   deprecated and rejected by the API.
# SARVAM_MAX_TOKENS=4096          # completion cap, sent explicitly
# PIPELINE_WORKERS=2              # concurrent pipeline jobs

# Set BOTH to require HTTP basic auth. Leave unset to disable (local dev).
# BASIC_AUTH_USER=
# BASIC_AUTH_PASS=
