# Copy to .env and fill in. Never commit the real .env.

# Local dev: postgresql+psycopg://user:pass@localhost:5432/evaluator
# Managed Postgres: paste the provider URL as-is — app/db.py normalizes the
# scheme to postgresql+psycopg:// automatically.
DATABASE_URL=

DEEPGRAM_API_KEY=
SARVAM_API_KEY=

# Optional
# SARVAM_CHAT_MODEL=sarvam-105b   # default; sarvam-30b also available
# PIPELINE_WORKERS=2              # concurrent pipeline jobs
# CHROMA_PATH=chroma_db           # set to a mounted disk path in deployment

# Set BOTH to require HTTP basic auth. Leave unset to disable (local dev).
# BASIC_AUTH_USER=
# BASIC_AUTH_PASS=
